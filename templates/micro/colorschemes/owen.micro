color-link default "{{foreground}},{{background}}"
color-link comment "{{muted}}"
color-link constant "{{cyan}}"
color-link identifier "{{foreground}}"
color-link statement "{{accent}}"
color-link type "{{yellow}}"
color-link symbol "{{magenta}}"
color-link special "{{green}}"
color-link error "{{red}}"
color-link statusline "{{foreground}},{{surface}}"
color-link tabbar "{{foreground}},{{surface}}"
color-link selection "{{background}},{{accent}}"
color-link line-number "{{muted}},{{background}}"
color-link current-line-number "{{accent}},{{background}}"
color-link indent-char "{{border}}"
